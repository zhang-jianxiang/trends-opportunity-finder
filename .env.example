# ============================================
# Neon PostgreSQL 数据库配置
# 从 Neon 控制台获取: Connection Details > Connection String
# ============================================
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ============================================
# Google Trends 采集配置（可选）
# ============================================
# 默认监控的关键词，用逗号分隔
TRENDS_KEYWORDS=artificial intelligence,machine learning,digital health,cryptocurrency,sustainable energy,remote work,electric vehicles,social media,online learning,fitness apps

# 默认监控的地区代码，用逗号分隔（空字符串表示全球）
TRENDS_REGIONS=,US,CN,GB,DE,JP

# 数据采集时间范围
TRENDS_TIMEFRAME=today 3-m

# ============================================
# 分析配置（可选）
# ============================================
ANALYSIS_TREND_UP_THRESHOLD=0.5
ANALYSIS_TREND_DOWN_THRESHOLD=-0.3
ANALYSIS_ANOMALY_THRESHOLD=2.0
ANALYSIS_OPPORTUNITY_THRESHOLD=60
